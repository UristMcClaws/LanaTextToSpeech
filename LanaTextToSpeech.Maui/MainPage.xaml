<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 x:Class="LanaTextToSpeech.Maui.MainPage"
			 Title="Lana TTS">
	<ScrollView>
		<VerticalStackLayout Padding="16"
							 Spacing="12">
			<Label Text="Model"
				   FontAttributes="Bold" />
			<Picker x:Name="ModelsPicker"
					Title="Select model" />

			<Label Text="Voice"
				   FontAttributes="Bold" />
			<Picker x:Name="VoicesPicker"
					Title="Select voice" />

			<Label Text="Text to speak"
				   FontAttributes="Bold" />
			<Entry x:Name="InputEditor"
				   Placeholder="Enter text here..."
				   Keyboard="Text"
				   HorizontalOptions="FillAndExpand"
				   VerticalOptions="Start"
				   HeightRequest="40" />

			<HorizontalStackLayout Spacing="8"
								   VerticalOptions="Center">
				<Label Text="Volume"
					   VerticalOptions="Center" />
				<Stepper x:Name="VolumeStepper"
						 Minimum="0"
						 Maximum="20"
						 Increment="1"
						 Value="10"
						 VerticalOptions="Center" />
				<Label x:Name="VolumeLabel"
					   Text="1.0x"
					   VerticalOptions="Center"
					   WidthRequest="50"
					   HorizontalTextAlignment="Center" />
			</HorizontalStackLayout>

			<HorizontalStackLayout Spacing="10">
				<Button x:Name="GenerateButton"
						Text="Generate"
						Clicked="GenerateButton_Clicked" />
				<Button x:Name="PlayButton"
						Text="Play"
						Clicked="PlayButton_Clicked"
						IsEnabled="False" />
				<Button x:Name="SaveButton"
						Text="Save"
						Clicked="SaveButton_Clicked"
						IsEnabled="False" />
			</HorizontalStackLayout>

			<Label x:Name="StatusLabel"
				   Text=""
				   FontAttributes="Italic"
				   LineBreakMode="TailTruncation" />

			<Label Text="History"
				   FontAttributes="Bold" />
			<CollectionView x:Name="HistoryList"
							HeightRequest="200"
							ItemsLayout="VerticalList"
							SelectionMode="None">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Label Text="{Binding .}"
							   LineBreakMode="WordWrap"
							   Padding="6" />
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>